# Copiar este archivo como .env y completar los valores. El archivo .env no se versiona ni se entrega.

# Conexión a la base de datos. PostgreSQL (recomendado):
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/foodstore_db
# Para desarrollo local también se acepta SQLite:
# DATABASE_URL=sqlite:///./foodstore.db

# Clave con la que se firma el JWT (mínimo 32 caracteres). Para generar una:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

# Algoritmo de firma del JWT
ALGORITHM=HS256

# Duración, en minutos, del token y de la cookie de sesión
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend autorizado por CORS
FRONTEND_ORIGIN=http://localhost:5173
